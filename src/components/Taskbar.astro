---
interface Item {
	id: string;
	label: string;
	/** Swapped in by CSS on narrow screens to keep the bar on one row. */
	labelShort?: string;
	href: string;
}

interface Props {
	items: Item[];
	active?: string;
}

const { items, active } = Astro.props;
---

<nav class="taskbar" aria-label="Site sections">
	<ul class="taskbar__list">
		{
			items.map((item) => (
				<li class="taskbar__item">
					<a
						class:list={["taskbar__link", { "taskbar__link--active": item.id === active }]}
						href={item.href}
						aria-current={item.id === active ? "page" : undefined}
						aria-label={item.labelShort ? item.label : undefined}
					>
						{item.labelShort ? (
							<>
								<span class="taskbar__label">{item.label}</span>
								<span class="taskbar__label--short">{item.labelShort}</span>
							</>
						) : (
							item.label
						)}
					</a>
				</li>
			))
		}
	</ul>
</nav>
