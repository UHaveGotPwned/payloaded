---
interface Props {
	/** The application name, not the page path: the Breadcrumb already says
	 *  where you are. */
	title?: string;
}

const { title = "payloaded" } = Astro.props;
---

<div class="window">
	<div class="window__bar">
		{/* A brand name, so it keeps English pronunciation whatever the page lang. */}
		<span class="window__title" lang="en">{title}</span>
		<span class="window__controls" aria-hidden="true">- [] X</span>
	</div>
	<div class="window__body">
		<slot />
	</div>
</div>
