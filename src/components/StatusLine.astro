---
import { DEFAULT_LOCALE, type Locale } from "../lib/integrity";
import { pathFor, strings } from "../lib/i18n";

interface Props {
	/** Empty values are dropped, so callers can pass conditionals unfiltered. */
	facts?: (string | null | undefined | false)[];
	mode?: string;
	locale?: Locale;
	/** Shared slug of this page in the other language; absent means untranslated,
	 *  and the toggle stays hidden rather than offering a dead link. */
	alternate?: string;
	section?: string;
}

const { facts = [], mode, locale = DEFAULT_LOCALE, alternate, section = "" } = Astro.props;
const other: Locale = locale === "es" ? "en" : "es";
const shown = facts.filter((fact): fact is string => Boolean(fact));
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const alternateHref = alternate === undefined ? null : pathFor(base, other, section, alternate);
const t = strings[locale].bar;
---

<div class="status" data-search>
	{
		shown.length > 0 && (
			<span class="status__facts" aria-hidden="true">
				{shown.join(" · ")}
			</span>
		)
	}

	{
		/* The affordance: "/" is the shortcut, but it is a real button so it works
	    by tap on mobile, where there is no keyboard to press "/" on. */
	}
	<button type="button" class="status__trigger" data-search-open>
		<span class="status__key" aria-hidden="true">/</span>
		<span>{t.trigger}</span>
	</button>

	{
		/* A plain GET form: Enter navigates to the results page with no JavaScript
	    involved, so search works even if the script never runs. */
	}
	<form
		class="status__form"
		action={pathFor(base, locale, "search")}
		method="get"
		role="search"
		hidden
		data-search-form
	>
		<label class="visually-hidden" for="search-input">{t.label}</label>
		<span class="status__key" aria-hidden="true">/</span>
		<input
			class="status__input"
			id="search-input"
			name="q"
			type="search"
			autocomplete="off"
			spellcheck="false"
			placeholder={t.placeholder}
			data-placeholder-short={t.placeholderShort}
			data-search-input
		/>
		<button type="button" class="status__clear" data-search-close>
			<span aria-hidden="true">✕</span>
			<span class="visually-hidden">{t.close}</span>
		</button>
	</form>

	{
		/* One cell for both: as separate grid children they claimed the same
	    column and stacked into a second row, growing the whole bar. */
	}
	<div class="status__end">
		{
			alternateHref && (
				<a
					class="status__lang"
					href={alternateHref}
					hreflang={other}
					aria-label={strings[other].switchTo}
				>
					<span class="status__lang-code status__lang-code--current" aria-hidden="true">
						{locale}
					</span>
					<span class="status__lang-code status__lang-code--target" aria-hidden="true">
						{other}
					</span>
				</a>
			)
		}

		{
			mode && (
				<span class="status__mode" aria-hidden="true">
					{mode}
				</span>
			)
		}
	</div>
</div>

<script>
	const trigger = document.querySelector<HTMLButtonElement>("[data-search-open]");
	const form = document.querySelector<HTMLFormElement>("[data-search-form]");
	const input = document.querySelector<HTMLInputElement>("[data-search-input]");
	const close = document.querySelector<HTMLButtonElement>("[data-search-close]");

	if (trigger && form && input && close) {
		/* The field is ~16 characters wide on a phone, so the full hint arrives
		   truncated. Swapped here rather than in CSS, which cannot reach an
		   attribute, and kept live so rotating the device corrects it. */
		const long = input.placeholder;
		const short = input.dataset.placeholderShort;
		const narrow = window.matchMedia("(max-width: 34rem)");
		const fit = () => {
			if (short) input.placeholder = narrow.matches ? short : long;
		};

		fit();
		narrow.addEventListener("change", fit);

		const open = () => {
			form.hidden = false;
			trigger.hidden = true;
			input.focus();
		};

		const dismiss = () => {
			form.hidden = true;
			trigger.hidden = false;
			input.value = "";
		};

		trigger.addEventListener("click", open);
		close.addEventListener("click", dismiss);

		document.addEventListener("keydown", (event) => {
			const typing =
				event.target instanceof HTMLElement && ["INPUT", "TEXTAREA"].includes(event.target.tagName);

			if (event.key === "/" && !typing) {
				event.preventDefault();
				open();
			} else if (event.key === "Escape" && !form.hidden) {
				dismiss();
			}
		});
	}
</script>
