---
import Base from "./Base.astro";
import Window from "../components/Window.astro";
import Prompt from "../components/Prompt.astro";
import Breadcrumb from "../components/Breadcrumb.astro";

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  active?: string;
  windowTitle?: string;
  breadcrumb?: Crumb[];
}

const { title, description, active, windowTitle, breadcrumb = [] } = Astro.props;
---

<Base title={title} description={description} active={active}>
	<Window title={windowTitle}>
		{breadcrumb.length > 0 && <Breadcrumb items={breadcrumb} />}
		<Prompt>{title}</Prompt>
		<div class="prose">
			<slot />
		</div>
	</Window>
</Base>
