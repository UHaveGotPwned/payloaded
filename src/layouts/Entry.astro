---
import Base from "./Base.astro";
import Window from "../components/Window.astro";
import Prompt from "../components/Prompt.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
import EduNotice from "../components/EduNotice.astro";
import type { Locale } from "../lib/integrity";

interface Crumb {
	label: string;
	href?: string;
}

interface Props {
	title: string;
	description?: string;
	active?: string;
	breadcrumb?: Crumb[];
	statusFacts?: (string | null | undefined | false)[];
	statusMode?: string;
	locale?: Locale;
	/** Shared slug of the same entry in the other language, when it exists. */
	alternate?: string;
}

const {
	title,
	description,
	active,
	breadcrumb = [],
	statusFacts,
	statusMode,
	locale,
	alternate,
} = Astro.props;
---

<Base
	title={`${title} · Payloaded`}
	description={description}
	active={active}
	statusFacts={statusFacts}
	statusMode={statusMode}
	locale={locale}
	alternate={alternate}
>
	<Window>
		{breadcrumb.length > 0 && <Breadcrumb items={breadcrumb} />}
		<article data-pagefind-body>
			<Prompt>{title}</Prompt>
			<div class="prose">
				<slot />
			</div>
			<EduNotice />
		</article>
	</Window>
</Base>
