---
import "../styles/tokens.css";
import "../styles/base.css";
import "../styles/components.css";
import Taskbar from "../components/Taskbar.astro";
import fontBody from "../assets/fonts/ibm-plex-mono-400.woff2?url";

interface Props {
  title: string;
  description?: string;
  active?: string;
  lang?: string;
}

const { title, description, active, lang = "es" } = Astro.props;
const base = import.meta.env.BASE_URL;

// Hrefs are built here so Taskbar stays dumb: it never touches routing or BASE_URL.
const sections = [
  { id: "home", label: "[_/_]", href: `${base}/` },
  { id: "malware", label: "Malware", href: `${base}/malware` },
  { id: "types", label: "Types", href: `${base}/types` },
  { id: "attack-vectors", label: "Attack vector", href: `${base}/attack-vectors` },
  { id: "indicators", label: "IOC/IOA", href: `${base}/indicators` },
];
---

<!doctype html>
<html lang={lang}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		{description && <meta name="description" content={description} />}
		<link rel="icon" type="image/png" href={`${base}/favicon.png`} />
		<link rel="icon" href={`${base}/favicon.ico`} sizes="any" />
		<link rel="preload" href={fontBody} as="font" type="font/woff2" crossorigin />
	</head>
	<body>
		<main>
			<slot />
		</main>
		<Taskbar items={sections} active={active} />
	</body>
</html>
