---
import Base from "../../layouts/Base.astro";
import Window from "../../components/Window.astro";
import Prompt from "../../components/Prompt.astro";
import EntryMenu from "../../components/EntryMenu.astro";
import { assertContentIntegrity, count, listFamilies, listEntries } from "../../lib/content";

await assertContentIntegrity();

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const families = await listFamilies();
const types = await listEntries("types");

// A family is browsable only if it has an entry to land on.
const items = families
  .filter((family) => types.some((type) => type.id === family.id))
  .map((family) => ({
    id: family.id,
    label: family.data.name,
    tagline: family.data.tagline,
    href: `${base}/types/${family.id}`,
  }));
---

<Base
	title="Types · Payloaded"
	description="Familias de malware recogidas en la wiki."
	active="types"
	statusFacts={[count(items.length, "entrada")]}
	statusMode="TYPES"
>
	<Window>
		<Prompt>Types</Prompt>
		<EntryMenu items={items} />
	</Window>
</Base>
