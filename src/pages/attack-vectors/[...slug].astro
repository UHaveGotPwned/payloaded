---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Entry from "../../layouts/Entry.astro";
import MetaList from "../../components/MetaList.astro";
import { count, listEntries } from "../../lib/content";

export const getStaticPaths = (async () => {
  const entries = await listEntries("attack-vectors");
  return entries.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}) satisfies GetStaticPaths;

const { entry } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const { Content } = await render(entry);

const breadcrumb = [
  { label: "Attack vectors", href: `${base}/attack-vectors` },
  { label: entry.data.title },
];
---

<Entry
	title={entry.data.title}
	description={entry.data.summary}
	active="attack-vectors"
	breadcrumb={breadcrumb}
	statusFacts={[count(entry.data.sources.length, "fuente")]}
	statusMode="VECTORS"
>
	<Content />

	<MetaList heading="Fuentes" items={entry.data.sources} tone="quiet" />
</Entry>
