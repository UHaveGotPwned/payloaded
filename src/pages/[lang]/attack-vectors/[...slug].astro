---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Entry from "../../../layouts/Entry.astro";
import MetaList from "../../../components/MetaList.astro";
import { findTranslation, listEntries } from "../../../lib/content";
import { LOCALES, splitLocale } from "../../../lib/integrity";
import { count, pathFor, strings } from "../../../lib/i18n";

export const getStaticPaths = (async () => {
	const pages = [];

	for (const lang of LOCALES) {
		for (const entry of await listEntries("attack-vectors", lang)) {
			const { slug } = splitLocale(entry.id);
			pages.push({
				params: { lang, slug },
				props: {
					entry,
					locale: lang,
					alternate: (await findTranslation(
						"attack-vectors",
						entry.id,
						lang === "es" ? "en" : "es",
					))
						? slug
						: undefined,
				},
			});
		}
	}

	return pages;
}) satisfies GetStaticPaths;

const { entry, locale, alternate } = Astro.props;
const t = strings[locale];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const { Content } = await render(entry);

const breadcrumb = [
	{ label: "Attack vectors", href: pathFor(base, locale, "attack-vectors") },
	{ label: entry.data.title },
];
---

<Entry
	title={entry.data.title}
	description={entry.data.summary}
	active="attack-vectors"
	breadcrumb={breadcrumb}
	locale={locale}
	alternate={alternate}
	statusFacts={[count(entry.data.sources.length, "source", locale)]}
	statusMode="VECTORS"
>
	<Content />

	<MetaList heading={t.sources} items={entry.data.sources} tone="quiet" />
</Entry>
