---
import type { GetStaticPaths } from "astro";
import { render } from "astro:content";
import Entry from "../../../layouts/Entry.astro";
import MetaList from "../../../components/MetaList.astro";
import { findTranslation, listEntries } from "../../../lib/content";
import { LOCALES, splitLocale } from "../../../lib/integrity";
import { count, pathFor, strings } from "../../../lib/i18n";

export const getStaticPaths = (async () => {
	const pages = [];

	for (const lang of LOCALES) {
		for (const entry of await listEntries("indicators", lang)) {
			const { slug } = splitLocale(entry.id);
			pages.push({
				params: { lang, slug },
				props: {
					entry,
					locale: lang,
					alternate: (await findTranslation("indicators", entry.id, lang === "es" ? "en" : "es"))
						? slug
						: undefined,
				},
			});
		}
	}

	return pages;
}) satisfies GetStaticPaths;

const { entry, locale, alternate } = Astro.props;
const t = strings[locale];
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const { Content } = await render(entry);

const breadcrumb = [
	{ label: "IOC/IOA", href: pathFor(base, locale, "indicators") },
	{ label: entry.data.title },
];
---

<Entry
	title={entry.data.title}
	description={entry.data.summary}
	active="indicators"
	breadcrumb={breadcrumb}
	locale={locale}
	alternate={alternate}
	statusFacts={[entry.data.kind.toUpperCase(), count(entry.data.sources.length, "source", locale)]}
	statusMode="IOC/IOA"
>
	<Content />

	<MetaList heading={t.sources} items={entry.data.sources} tone="quiet" />
</Entry>
